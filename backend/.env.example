# Copia este archivo como ".env" y coloca tus datos reales.
# NUNCA subas el archivo ".env" real a un repositorio publico.

SECRET_KEY=cambia-esta-clave-por-una-segura
DEBUG=True

# Datos de conexion a MySQL
DB_NAME=coleccion_autos
DB_USER=root
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=3306

# Dominios permitidos separados por coma (para produccion)
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
